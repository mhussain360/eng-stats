// dataProcessor.js - Handles data loading and processing

const DataProcessor = (function() {
    // Module variables
    let csvData = [];
    let monthColumns = [];
    let currentFilteredData = [];

    // Parse the uploaded CSV file
    function parseCSV() {
        // Fetch CSV data from the server endpoint
        fetch('/api/stats')
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.text();
            })
            .then(csvText => {
                // Parse the CSV text using PapaParse
                Papa.parse(csvText, {
                    header: true,
                    dynamicTyping: false, // Keep everything as strings initially
                    skipEmptyLines: true, // Skip empty lines
                    complete: function(results) {
                        if (results.data && results.data.length > 0) {
                            // Make sure we have valid data with the Developer Name field
                            csvData = results.data.filter(row => row['Developer Name'] && row['Developer Name'].trim() !== '');

                            // Log data for debugging
                            if (DEBUG) {
                                console.log('CSV Data:', csvData);
                            }

                            // Identify month columns (any column after the first 4)
                            const allColumns = Object.keys(results.data[0]);
                            monthColumns = allColumns.slice(4);

                            // Initialize the application with data
                            initializeApp();
                        } else {
                            alert('The CSV file appears to be empty or improperly formatted.');
                        }
                    },
                    error: function(error) {
                        console.error('Error parsing CSV:', error);
                        alert('Error parsing CSV file. Please check the file format.');
                    }
                });
            })
            .catch(error => {
                console.error('Error fetching CSV data:', error);
                alert(`Error fetching CSV data: ${error.message}`);
            });
    }

    // Initialize the application with the loaded data
    function initializeApp() {
        // Show the main content
        document.getElementById('mainContent').style.display = 'block';

        // Store the full dataset for reference
        currentFilteredData = [...csvData];

        // Convert month data from strings to numbers for visualization
        convertMonthDataToNumbers();

        // Populate filter dropdowns
        FilterManager.populateFilters(csvData);

        // Populate month dropdown for comparison
        populateMonthDropdown();

        // Create initial charts
        ChartManager.createActivityChart(monthColumns);
        ChartManager.createComparisonChart();

        // Display data table
        TableManager.displayDataTable(csvData, monthColumns);

        // Update record count display
        TableManager.updateRecordCount(csvData.length);
    }

    // Convert month data from strings to numbers for visualization
    function convertMonthDataToNumbers() {
        csvData.forEach(row => {
            monthColumns.forEach(month => {
                // Convert to number, handle empty or non-numeric values
                const value = row[month];
                row[month] = value === "" || value === null || value === undefined ? 0 : Number(value);
            });
        });
    }

    // Populate the month dropdown for comparison
    function populateMonthDropdown() {
        const dropdown = document.getElementById('compareMonthSelect');
        dropdown.innerHTML = '';

        monthColumns.forEach(month => {
            const option = document.createElement('option');
            option.value = month;
            option.textContent = month;
            dropdown.appendChild(option);
        });

        // Select the first month by default
        if (monthColumns.length > 0) {
            dropdown.value = monthColumns[0];
        }
    }

    // Get filtered data
    function getFilteredData() {
        return currentFilteredData;
    }

    // Set filtered data
    function setFilteredData(data) {
        currentFilteredData = data;
    }

    // Get all CSV data
    function getAllData() {
        return csvData;
    }

    // Get month columns
    function getMonthColumns() {
        return monthColumns;
    }

    // Return public methods and properties
    return {
        parseCSV,
        getFilteredData,
        setFilteredData,
        getAllData,
        getMonthColumns
    };
})();
